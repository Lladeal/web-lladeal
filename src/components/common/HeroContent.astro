---
import Button from '@ui/Button.astro';
import { getHomeContent, getLocaleFromUrl } from '@/i18n/content';

const locale = getLocaleFromUrl(Astro.url);
const { hero } = getHomeContent(locale);

---

{/* Hero Content */}
<div class="mx-auto max-w-4xl text-left select-none sm:text-center">
  <h1
    class="block text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
  >
    {hero.titulo}
  </h1>
</div>

<div class="mx-auto max-w-3xl text-left sm:text-center">
  <p class="text-lg text-pretty text-slate-700">
    {hero.subtitulo}
  </p>
</div>

{/* CTA Buttons */}
<div class="flex flex-col justify-center gap-5 sm:flex-row">
  <Button href={hero.boton_2.link} variant="secondary" target="_blank"
    >{hero.boton_2.titulo}</Button
  >
  <Button href={hero.Boton_1.link} variant="primary">{hero.Boton_1.titulo}</Button>
</div>
