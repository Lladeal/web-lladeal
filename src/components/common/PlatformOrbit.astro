---
import { Icon } from 'astro-icon/components';
import { getHomeContent, getLocaleFromUrl } from '@/i18n/content';
import { withBase } from '@utils/links';

const locale = getLocaleFromUrl(Astro.url);
const { features } = getHomeContent(locale);
---

<div
  id="circle-orbit-container"
  class="relative m-auto mt-2 mb-5 h-[200px] w-[200px]"
>
  {/* Inner orbit */}
  <div
    class="absolute top-1/2 left-1/2 h-[100px] w-[100px] -translate-x-1/2 -translate-y-1/2 transform"
    id="orbita_1"
  >
    <p
      class="dm-sans absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transform text-lg" id="imagen"
    >
      <img
        id="imagen-central"
        class="mr-1 inline-block size-5 h-auto w-6 text-slate-500"
        src={withBase(features.Orbita.Imagen_central) ?? ''}
        height={20}
        width={20}
        alt=""
      />
    </p>
    <div
      id="orbita_1_giro"
      class="absolute inset-0 rounded-full border border-dashed border-slate-500"
    >
      {/* Excel icon */}
      <Icon
        name={features.Orbita.Icono_1}
        class="absolute -top-1 right-16 size-6 text-slate-500"
      />
    </div>
  </div>

  {/* Middle orbit (macOS) */}
  <div
    class="absolute top-1/2 left-1/2 h-[150px] w-[150px] -translate-x-1/2 -translate-y-1/2 transform rounded-full border border-dashed border-slate-400"
    id="orbita_2"
  >
    <Icon
      name={features.Orbita.Icono_2}
      class="absolute bottom-3 size-8 text-slate-600"
    />
  </div>

  {/* Outer orbit (ARM) */}
  <div
    class="absolute top-1/2 left-1/2 h-[200px] w-[200px] -translate-x-1/2 -translate-y-1/2 transform rounded-full border border-dashed border-slate-300"
    id="orbita_3"
  >
    <Icon
      name={features.Orbita.Icono_3}
      class="absolute right-6 size-8 text-slate-500"
    />
  </div>
</div>
<style>
  #orbita_1_giro {
    animation: giro_1 90s infinite linear;
  }
  #orbita_2 {
    animation: giro_1 50s infinite linear;
  }

  #orbita_3 {
    animation: giro_1 30s infinite linear;
  }
  @keyframes giro_1 {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

</style>
