---
import Icon from '@ui/icons/Icon.astro';
import type { Locale } from '@/i18n/config';
import { getUiStrings } from '@/i18n/ui';

const { address, phone, email, website, locale = 'es' } = Astro.props as {
  address: string;
  phone: string;
  email: string;
  website: string;
  locale?: Locale;
};
const t = getUiStrings(locale).footer;
---

<div>
  <h3 class="font-semibold text-slate-700">{t.contactUs}</h3>
  <ul class="mt-3 space-y-2 text-sm text-slate-600">
    <li>Lladeal®</li>
    <li>{address}</li>
    <li class="flex items-center gap-x-2">
      <Icon name="mobile" />
      <a
        href={'tel:+' + phone.replace(/[^+\d]/g, '')}
        class="transition-colors duration-300 hover:text-slate-500">{phone}</a
      >
    </li>
    <li class="flex items-center gap-x-2">
      <Icon name="email" />
      <a
        href={'mailto:' + email}
        class="transition-colors duration-300 hover:text-slate-500">{email}</a
      >
    </li>
    <li class="flex items-center gap-x-2">
      <Icon name="world" />
      <a
        href={'https://' + website}
        class="transition-colors duration-300 hover:text-slate-500">{website}</a
      >
    </li>
  </ul>
</div>
