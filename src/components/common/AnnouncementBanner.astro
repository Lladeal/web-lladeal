---
import Icon from '@ui/icons/Icon.astro';
import { getHomeContent, getLocaleFromUrl } from '@/i18n/content';

const locale = getLocaleFromUrl(Astro.url);
const { anuncio } = getHomeContent(locale);
---

<div class="flex justify-center">
  <div class="rounded-xl bg-slate-50 shadow-md">
    <a
      href={anuncio.link}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex h-9 w-fit items-center justify-center gap-0 rounded-xl transition duration-300"
      aria-label=`${anuncio.titulo} - ${anuncio.titulo_link}`
    >
      <div
        class="flex h-full w-fit items-center gap-2 rounded-xl bg-linear-to-tr/oklch from-[#e3186d] to-[#4f274d] px-3"
      >
        <span class="text-sm text-white">{anuncio.titulo}</span>
      </div>
      <div
        class="hidden h-full w-fit items-center justify-center gap-2 px-3 sm:flex"
      >
        <span
          class="text-astro-slate-100 text-sm transition duration-300 group-hover:underline"
          >{anuncio.titulo_link}</span
        >
        <Icon name="chevronRight" />
      </div>
    </a>
  </div>
</div>
