---
import { Image } from 'astro:assets';
import chartImage from '@images/chart.webp';
import { imagen } from '@content/pages/home.json'
import { withBase } from '@utils/links';

const heroData = imagen as typeof imagen & { ImagenArchivo?: string };
const heroImage = heroData.ImagenArchivo?.trim() || heroData.Imagen?.trim();
---

{/* Hero Visual */}
<div class="relative m-auto w-full pt-16 sm:w-[90%]">
  <div
    class="via-off-white to-off-white pointer-events-none absolute inset-x-0 -bottom-2 z-10 hidden h-20 w-full bg-linear-to-b/oklch from-transparent sm:block"
  >
  </div>

  {
    heroImage ? (
      <img
        src={heroImage}
        alt="Chart"
        loading="eager"
        class="absolute inset-[25%_auto_auto_-8%] z-20 hidden w-[25%] sm:block"
      />
    ) : (
      <Image
        src={chartImage}
        alt="Chart"
        loading={'eager'}
        inferSize={true}
        class="absolute inset-[25%_auto_auto_-8%] z-20 hidden w-[25%] sm:block"
      />
    )
  }

  <div class="aspect-video">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
        poster={withBase('/poster.png')}
      class="aspect-auto rounded-xl"
    >
      <source src={imagen.video} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>
</div>
