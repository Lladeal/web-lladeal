---
import { getHomeContent, getLocaleFromUrl } from '@/i18n/content';
import { getUiStrings } from '@/i18n/ui';
import { withBase } from '@utils/links';

const locale = getLocaleFromUrl(Astro.url);
const { imagen } = getHomeContent(locale);
const t = getUiStrings(locale).footer;
const heroData = imagen as typeof imagen & {
  usarVideo?: boolean;
  ImagenArchivo?: string;
  Imagen?: string;
};
const heroImage = heroData.ImagenArchivo?.trim() || heroData.Imagen?.trim();
const heroImageSrc = heroImage ? withBase(heroImage) : undefined;
const heroVideoSrc = imagen.video ? withBase(imagen.video) : undefined;
const shouldRenderVideo = heroData.usarVideo !== false && !!heroVideoSrc;
---

{/* Hero Visual */}
<div class="relative m-auto w-full pt-16 sm:w-[90%]">
  <div
    class="via-off-white to-off-white pointer-events-none absolute inset-x-0 -bottom-2 z-10 hidden h-20 w-full bg-linear-to-b/oklch from-transparent sm:block"
  >
  </div>

  {heroImage && (
    <img
      src={heroImageSrc}
      alt="Chart"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-[10%_auto_auto_2%] z-20 hidden w-[10%] sm:block"
    />
  )}

  <div class="aspect-video overflow-hidden rounded-xl">
    {
      shouldRenderVideo ? (
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={withBase('/poster.png')}
          class="h-full w-full object-cover"
        >
          {heroVideoSrc && <source src={heroVideoSrc} type="video/mp4" />}
          {t.videoFallback}
        </video>
      ) : heroImageSrc ? (
        <img
          src={heroVideoSrc}
          alt="Visual principal"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-slate-100 text-sm text-slate-500">
          {t.videoFallback}
        </div>
      )
    }
  </div>
</div>
