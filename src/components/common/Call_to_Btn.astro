---
import { Icon } from 'astro-icon/components'
---

<a
  href="https://wa.link/w9n4jn"
  target="_blank"
  rel="noreferrer noopener"
  class="fixed right-4 bottom-20 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-linear-to-r from-[#e3186d] to-[#4f274d]"
  title="Go to e-comerse"
  aria-label="Go to e-comerse"
>
  <div
    class="ping-custom-2 absolute top-0 left-0 z-10 h-full w-full rounded-full bg-[#4f274d]"
  >
  </div>
  <div class="relative z-20 text-white">
    <Icon name="RiShoppingCart2Line" height="24px"
      width="24px" />
  </div>
</a>
<style>
  .ping-custom-2 {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) 0.05s infinite;
  }
</style>
