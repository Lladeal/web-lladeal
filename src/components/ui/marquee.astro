---
import { withBase } from '@utils/links';
import { marquee } from '@content/pages/marquee.json';
import { getLocaleFromUrl } from '@/i18n/content';

const locale = getLocaleFromUrl(Astro.url);
const labelsByLocale = {
  es: {
    close: 'Cerrar',
    closeExpandedImage: 'Cerrar imagen ampliada',
    viewExpandedImage: 'Ver imagen ampliada de',
  },
  en: {
    close: 'Close',
    closeExpandedImage: 'Close enlarged image',
    viewExpandedImage: 'View enlarged image of',
  },
  de: {
    close: 'Schliessen',
    closeExpandedImage: 'Vergrossertes Bild schliessen',
    viewExpandedImage: 'Vergrossertes Bild ansehen von',
  },
  ru: {
    close: 'Закрыть',
    closeExpandedImage: 'Закрыть увеличенное изображение',
    viewExpandedImage: 'Открыть увеличенное изображение',
  },
  zh: {
    close: '关闭',
    closeExpandedImage: '关闭放大图片',
    viewExpandedImage: '查看放大图片：',
  },
} as const;
const labels = labelsByLocale[locale];
---

<div
  class="relative flex flex-col gap-2 overflow-hidden before:pointer-events-none before:absolute before:inset-y-0 before:start-0 before:z-2 before:w-20 before:bg-[linear-gradient(to_right,var(--color-background),transparent)] after:pointer-events-none after:absolute after:inset-y-0 after:end-0 after:z-2 after:w-20 after:bg-[linear-gradient(to_left,var(--color-background),transparent)]"
>
  <!-- Row -->
  <div class="flex overflow-hidden">
    <div
      class="marquee-track-x flex w-max [animation:marquee-x_68s_linear_infinite] gap-4 py-1 hover:[animation-play-state:paused]"
    >
      <!-- Col -->
      <div class="flex gap-4">
        <!-- Carc -->
        {
          marquee.map(lista => (
            <figure class="border-card-line bg-card w-72 shrink-0 rounded-xl border p-4 shadow-xs">
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  class="w-full cursor-zoom-in"
                  data-marquee-image-trigger
                  data-src={withBase(`${lista.src}`)}
                  data-alt={lista.alt}
                  aria-label={`${labels.viewExpandedImage} ${lista.alt}`}
                >
                  <img
                    class="h-full w-full rounded-2xl object-cover"
                    src={withBase(`${lista.src}`)}
                    alt={lista.alt}
                    loading="lazy"
                  />
                </button>
              </div>
            </figure>
          ))
        }
      </div>
      <!-- End Col -->
    </div>
  </div>
  <!-- End Row -->
</div>

<dialog
  data-marquee-image-modal
  class="m-auto max-h-[90vh] max-w-[90vw] overflow-hidden rounded-2xl border-0 bg-transparent p-0 backdrop:bg-black/75"
>
  <div class="relative">
    <button
      type="button"
      class="absolute top-3 right-3 z-10 rounded-full bg-black/65 px-3 py-1 text-sm font-semibold text-white transition hover:bg-black/80"
      data-marquee-image-close
      aria-label={labels.closeExpandedImage}
    >
      {labels.close}
    </button>

    <img
      data-marquee-image-preview
      src=""
      alt=""
      class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain opacity-0 shadow-2xl transition-opacity duration-150"
    />
  </div>
</dialog>
<!-- End Grid -->

<style>
  @keyframes marquee-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  @keyframes marquee-y {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-50% - 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track-x,
    .marquee-track-y {
      animation-duration: 1ms;
      animation-iteration-count: 1;
    }
  }
</style>

<script>
  const setupMarqueeImageModal = () => {
    const modal = document.querySelector('[data-marquee-image-modal]');
    const preview = document.querySelector('[data-marquee-image-preview]');
    const closeButton = document.querySelector('[data-marquee-image-close]');
    const triggers = document.querySelectorAll('[data-marquee-image-trigger]');

    if (
      !(modal instanceof HTMLDialogElement) ||
      !(preview instanceof HTMLImageElement) ||
      modal.dataset.bound === 'true'
    ) {
      return;
    }

    modal.dataset.bound = 'true';

    const loadPreviewImage = (src: string, alt: string) => {
      preview.style.opacity = '0';

      const nextImage = new Image();
      nextImage.onload = () => {
        preview.src = src;
        preview.alt = alt;
        preview.style.opacity = '1';
      };
      nextImage.src = src;
    };

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-src');
        const alt = trigger.getAttribute('data-alt') ?? '';

        if (!src) return;

        if (!modal.open) {
          modal.showModal();
        }

        loadPreviewImage(src, alt);
      });
    });

    closeButton?.addEventListener('click', () => {
      modal.close();
    });

    modal.addEventListener('click', event => {
      if (event.target === modal) {
        modal.close();
      }
    });

    modal.addEventListener('close', () => {
      preview.style.opacity = '0';
    });
  };

  setupMarqueeImageModal();
  document.addEventListener('astro:page-load', setupMarqueeImageModal);
</script>
