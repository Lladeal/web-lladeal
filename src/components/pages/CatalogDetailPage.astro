---
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import { Image } from 'astro:assets';
import { getCatalogContent, getLocaleFromUrl } from '@/i18n/content';
import { formatCatalogSpecValue } from '@utils/catalog-format';
import { withBase } from '@utils/links';

const { item } = Astro.props as {
  item: {
    titulo: string;
    descripcion: string;
    ImagenArchivo: string;
    tipo: string;
    Data: {
      Tamaño_del_boton: string;
      Longitud_del_tallo: string;
      Vida_en_florero: string;
      Numero_de_petalos: string;
      Estado_fenologico: string;
      Ciclo: string;
      link: string;
    };
  };
};

const locale = getLocaleFromUrl(Astro.url);
const { detail } = getCatalogContent(locale);
const technicalData = item.Data ?? {
  Tamaño_del_boton: '-',
  Longitud_del_tallo: '-',
  Vida_en_florero: '-',
  Numero_de_petalos: '-',
  Estado_fenologico: '-',
  Ciclo: '-',
  link: '#',
};

const seo = {
  title: `${item.titulo} | ${detail.badge}`,
  description: item.descripcion,
};

const specs = [
  {
    label: detail.specs.budSize,
    value: formatCatalogSpecValue(
      locale,
      'Tamaño_del_boton',
      technicalData.Tamaño_del_boton
    ),
  },
  {
    label: detail.specs.stemLength,
    value: formatCatalogSpecValue(
      locale,
      'Longitud_del_tallo',
      technicalData.Longitud_del_tallo
    ),
  },
  {
    label: detail.specs.vaseLife,
    value: formatCatalogSpecValue(
      locale,
      'Vida_en_florero',
      technicalData.Vida_en_florero
    ),
  },
  {
    label: detail.specs.petals,
    value: formatCatalogSpecValue(
      locale,
      'Numero_de_petalos',
      technicalData.Numero_de_petalos
    ),
  },
  {
    label: detail.specs.phenologicalStage,
    value: formatCatalogSpecValue(
      locale,
      'Estado_fenologico',
      technicalData.Estado_fenologico
    ),
  },
  {
    label: detail.specs.cycle,
    value: formatCatalogSpecValue(locale, 'Ciclo', technicalData.Ciclo),
  },
];
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-36 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p
          class="text-sm font-semibold tracking-[0.2em] text-pink-600 uppercase"
        >
          {detail.badge}
        </p>
        <h1
          class="mt-4 text-4xl font-bold text-slate-800 sm:text-5xl lg:text-6xl"
        >
          {item.titulo}
        </h1>
        <p
          class="mt-4 text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase"
        >
          {item.tipo}
        </p>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-700">
          {item.descripcion}
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          {
            technicalData.link !== '#' && (
              <Button href={technicalData.link}>{detail.consultButton}</Button>
            )
          }
          <Button href="/catalogo" variant="alternative"
            >{detail.backButton}</Button
          >
        </div>
      </div>

      <div
        class="overflow-hidden rounded-3xl bg-linear-to-br from-[#f7d2e3] via-white to-[#fdecef] p-6 shadow-xl ring-1 ring-slate-200/70"
      >
        <Image
          src={withBase(item.ImagenArchivo)}
          alt={item.descripcion}
          inferSize={false}
          width={900}
          height={1100}
          class="mx-auto h-auto w-full max-w-md"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-24 sm:px-6 lg:px-8">
    <div
      class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm"
    >
      <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
        <h2 class="text-2xl font-semibold text-slate-800">
          {detail.specsTitle}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        {
          specs.map(spec => (
            <div class="border-b border-slate-100 px-6 py-5 sm:px-8 lg:[&:nth-last-child(-n+3)]:border-b-0">
              <p class="text-xs font-semibold tracking-[0.16em] text-slate-500 uppercase">
                {spec.label}
              </p>
              <p class="mt-2 text-lg font-semibold text-slate-800">
                {spec.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
