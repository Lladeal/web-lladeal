---
// import Downloads from '@megaMenu/Downloads.astro';
// import Support from '@megaMenu/Support.astro';
// import Platform from '@megaMenu/Platform.astro';
// import Features from '@megaMenu/Features.astro';
import Button from '@ui/Button.astro';
import { localizePath, stripBase, withBase } from '@utils/links';
import { getNavigationLinks } from '@utils/navigation';
import { localeMetadata, locales, type Locale } from '@/i18n/config';
import { getLocaleFromUrl, getNavbarContent } from '@/i18n/content';
import { getUiStrings } from '@/i18n/ui';

const currentPath = stripBase(Astro.url.pathname);
const locale = getLocaleFromUrl(Astro.url);
const { barra_de_navegacion } = getNavbarContent(locale);
const t = getUiStrings(locale).nav;
const navigationLinks = getNavigationLinks(locale);
const localizedCurrentPath = stripBase(Astro.url.pathname);
const currentPathSegments = localizedCurrentPath.split('/').filter(Boolean);
const currentPathWithoutLocale =
  currentPathSegments[0] && locales.includes(currentPathSegments[0] as Locale)
    ? `/${currentPathSegments.slice(1).join('/')}` || '/'
    : localizedCurrentPath;
const languageLinks = locales.map(targetLocale => ({
  locale: targetLocale,
  label: localeMetadata[targetLocale].label,
  href: withBase(localizePath(currentPathWithoutLocale || '/', targetLocale)),
  active: targetLocale === locale,
}));
type NavigationLink = (typeof navigationLinks)[number];
---

<header
  class="fixed start-1/2 top-5 z-50 mx-auto flex w-full max-w-sm -translate-x-1/2 transform flex-wrap rounded-2xl border-b border-slate-100 bg-white bg-linear-to-t/oklch from-teal-100 via-transparent to-white p-1 shadow-xs sm:max-w-xl md:max-w-4xl md:flex-nowrap md:justify-start lg:max-w-5xl xl:max-w-6xl xl:shadow-none xl:ring-teal-950/5 2xl:max-w-[81rem] 2xl:via-0%"
>
  <nav
    class="relative mx-auto w-full px-4 py-2 sm:px-6 lg:px-8 xl:flex xl:max-w-7xl xl:items-center xl:justify-between xl:gap-3 2xl:max-w-[85rem]"
  >
    <div class="flex items-center justify-between gap-x-1">
      <a
        class="dm-sans flex-none text-2xl font-light text-slate-400 focus:opacity-80 focus:outline-hidden"
        href={withBase('/', locale)}
        aria-label={`Lladeal ${t.logoAltSuffix}`}
        translate="no"
        >
         <img src={barra_de_navegacion.logo.imagen} alt={barra_de_navegacion.logo.descripcion} class="w-35">
        </a
      >

      <button
        type="button"
        class="hs-collapse-toggle relative flex size-9 items-center justify-center rounded-lg border border-slate-200 text-[12px] font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden xl:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <svg
          class="hs-collapse-open:hidden size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="3" x2="21" y1="6" y2="6"></line><line
            x1="3"
            x2="21"
            y1="12"
            y2="12"></line><line x1="3" x2="21" y1="18" y2="18"></line></svg
        >
        <svg
          class="hs-collapse-open:block hidden size-4 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
        <span class="sr-only">Toggle navigation</span>
      </button>
    </div>

    <div
      id="hs-header-base"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 xl:ml-12 xl:block 2xl:ml-20"
      aria-labelledby="hs-header-base-collapse"
    >
      <div
        class="max-h-[75vh] overflow-hidden overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-slate-300 [&::-webkit-scrollbar-track]:bg-slate-100"
      >
        <div
          class="flex flex-col gap-0.5 py-2 xl:flex-row xl:items-center xl:gap-1 xl:py-0"
        >
          <div class="grow">
            <div
              class="flex flex-col gap-0.5 xl:flex-row xl:items-center xl:justify-evenly xl:gap-1"
            >
              <a
                 href={withBase('/', locale)}
                class={`flex items-center rounded-lg p-2 font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden ${
                  currentPath === '/' ? 'underline underline-offset-4' : ''
                }`}
                aria-current={currentPath === '/' ? 'page' : undefined}
              >
                 {t.home}
              </a>

              <!-- <Features />

              <Platform />

              <Downloads /> -->

              <!-- <Support /> -->

              {
                navigationLinks.map((link: NavigationLink) => (
                    <a
                      href={link.href}
                      class={`flex items-center rounded-lg p-2 font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden ${
                        currentPath === link.path
                          ? 'underline underline-offset-4'
                          : ''
                      }`}
                      aria-current={
                        currentPath === link.path ? 'page' : undefined
                      }
                    >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>

           <div
             class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-2 xl:mt-0 xl:ml-6"
           >
            <label class="sr-only" for="locale-switch">Cambiar idioma</label>
            <div class="relative min-w-20">
              <select
                id="locale-switch"
                data-locale-select
                class="w-full appearance-none rounded-xl border border-slate-200/80 bg-white/95 py-2 pr-5 pl-3 text-sm font-semibold text-slate-700 shadow-xs ring-1 ring-white/70 transition outline-hidden hover:border-slate-300 hover:bg-slate-50 focus:border-slate-400 focus:bg-white"
                aria-label="Cambiar idioma"
              >
                {
                  languageLinks.map(link => (
                    <option
                      value={link.href}
                      data-locale={link.locale}
                      selected={link.active}
                    >
                      {link.label}
                    </option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-slate-500"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
            <Button
              href={barra_de_navegacion.boton.link}
              variant="primary"
              target="_blank"
              className="inline-flex border-none py-2! text-nowrap"
              >{barra_de_navegacion.boton.texto}</Button
            >
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const bindLocaleSelect = () => {
      const select = document.querySelector('[data-locale-select]');
      if (!select || select.dataset.bound === 'true') return;

      select.dataset.bound = 'true';
      select.addEventListener('change', event => {
        const currentSelect = event.currentTarget;
        const selectedOption = currentSelect.options[currentSelect.selectedIndex];
        const locale = selectedOption?.dataset.locale;
        const href = currentSelect.value;

        if (locale) {
          localStorage.setItem('preferredLocale', locale);
        }

        if (href && href !== window.location.pathname) {
          window.location.assign(href);
        }
      });
    };

    bindLocaleSelect();
    document.addEventListener('astro:page-load', bindLocaleSelect);
  })();
</script>

<script>
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });
</script>
