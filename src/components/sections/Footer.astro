---
import FooterForm from '@ui/forms/FooterForm.astro';
import ContactInfo from '@common/ContactInfo.astro';
import { withBase } from '@utils/links';
import { getFooterContent, getLocaleFromUrl } from '@/i18n/content';
import { getUiStrings } from '@/i18n/ui';

// Dynamic date for copyright display
const copyrightYear = new Date().getFullYear();
const locale = getLocaleFromUrl(Astro.url);
const { generales, contactos, creacion, noticia } = getFooterContent(locale);
const t = getUiStrings(locale).footer;

---

<footer
  class="mt-auto w-full bg-linear-to-t/oklch from-[#e3186d]/20 via-transparent to-white pb-10"
>
  <div class="mx-auto mt-auto w-full max-w-340 px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="mb-10 border-slate-200" />

    <div class="grid grid-cols-2 gap-6 md:grid-cols-5">
      {/* Company Information */}
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href={withBase('/', locale)}
          class="flex-none text-xl font-semibold text-slate-700 uppercase focus:opacity-80 focus:outline-hidden"
          aria-label="{companyName} Homepage"
        >
          {generales.nombre_empresa}
        </a>
        <p class="mt-5 text-pretty text-slate-600 lg:w-5/12 xl:w-10/12">
          {generales.Descripcion}
        </p>
      </div>

      {/* Contact Information Section */}
      <div class="col-span-1 md:col-span-2 xl:col-span-1 xl:col-start-3">
        <ContactInfo {...contactos} locale={locale} />
      </div>

      {/* Email Subscription Form */}
      <div class="col-span-2 md:col-span-3 xl:col-span-2">
        <h3 class="font-semibold text-slate-700">{t.moreInfo}</h3>
        <FooterForm />
      </div>
    </div>

    {/* Divider before footer's bottom section */}
    <hr class="mt-10 mb-5 border-slate-200" />

    <div
      class="grid gap-y-2 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      {/* Copyright and Crafted By Section */}
      <p class="text-sm text-slate-400/50">
        &copy; 2026-{copyrightYear}
        {generales.nombre_empresa} {t.craftedBy}
        <a
          href={creacion.Link}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium underline underline-offset-2 ring-slate-400 outline-hidden transition duration-300 hover:text-slate-400 hover:decoration-dashed focus:outline-hidden focus-visible:ring-3"
        >
          {creacion.nombre}
        </a>
      </p>

      {/* Trademark Notice */}
      <p class="text-sm text-slate-400/50">
        <Fragment set:html={noticia.titulo} />
      </p>
    </div>
  </div>
</footer>
