---
import { carrusel } from '@content/pages/home.json';
import { Image } from 'astro:assets';
import Button from '@ui/Button.astro';
---

<div class="mx-auto max-w-340 px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  <!-- Carousel -->
  <div
    data-hs-carousel='{
    "loadingClasses": "opacity-0", "isInfiniteLoop": true, "isAutoPlay": true, "isDraggable": true
  }'
    class="relative"
  >
    <div class="hs-carousel flex h-fit flex-col gap-2 sm:flex-row">
      <div class="relative grow overflow-hidden rounded-lg sm:order-2">
        <div
          class="hs-carousel-body absolute inset-s-0 top-0 bottom-0 flex flex-nowrap opacity-0 transition-transform duration-700"
        >
          {
            carrusel.map((items, index) => (
              <div class="hs-carousel-slide">
                <article class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl md:flex-row">
                  <div class="group relative w-full overflow-hidden bg-linear-to-bl from-[#7e2c75] to-[#4f274d] md:w-1/2">
                    <Image
                      src={items.ImagenArchivo}
                      alt={items.descripcion}
                      inferSize={false}
                      width={130}
                      height={70}
                      class="test rounded-md w-full h-auto"
                    />
                    <div class="absolute top-6 left-6">
                      <span class="rounded-full border border-slate-200 bg-white/90 px-3 py-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase backdrop-blur-sm">
                        Selección premium
                      </span>
                    </div>
                  </div>
                  <div class="flex w-full flex-col justify-center bg-white p-8 md:w-1/2 md:p-12">
                    <header class="mb-8">
                      <h1 class="mb-2 text-4xl font-bold text-pink-600">
                        {items.titulo}
                      </h1>
                      <div class="flex items-center gap-2 text-slate-900">
                        <span class="material-symbols-outlined text-lg">
                          potted_plant
                        </span>
                        <p class="text-xs font-bold tracking-[0.2em] uppercase">
                          {items.tipo}
                        </p>
                      </div>
                    </header>
                    <div class="flex flex-col">
                      <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Tamaño del botón
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Tamaño_del_boton}
                        </span>
                      </div>
                      <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Longitud de tallo
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Longitud_del_tallo}
                        </span>
                      </div>
                      <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Vida en florero
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Vida_en_florero}
                        </span>
                      </div>
                      <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Número de pétalos
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Numero_de_petalos}
                        </span>
                      </div>
                      <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Estado fenológico
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Estado_fenologico}
                        </span>
                      </div>
                      <div class="flex items-center justify-between py-4">
                        <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
                          Ciclo
                        </span>
                        <span class="text-base font-semibold text-slate-900">
                          {items.Data.Ciclo}
                        </span>
                      </div>
                    </div>
                    <div class="mt-10 flex gap-3">
                      <button class="flex flex-1 items-center justify-center gap-2 rounded-md bg-slate-900 px-8 py-4 text-xs font-bold tracking-widest text-white uppercase transition-colors hover:bg-slate-800">
                        {/* <span class="material-symbols-outlined text-lg">
                          science
                        </span> */}
                        Saber más
                      </button>
                      
                    </div>
                  </div>
                </article>
              </div>
            ))
          }
        </div>

        <!-- Arrows -->
        <button
          type="button"
          class="hs-carousel-prev hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default bg-layer text-layer-foreground hover:bg-layer-hover absolute inset-s-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full shadow-2xs focus:outline-hidden"
        >
          <span class="text-2xl" aria-hidden="true">
            <svg
              class="size-5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
            >
          </span>
          <span class="sr-only">Previous</span>
        </button>
        <button
          type="button"
          class="hs-carousel-next hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default bg-layer text-layer-foreground hover:bg-layer-hover absolute inset-e-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full shadow-2xs focus:outline-hidden"
        >
          <span class="sr-only">Next</span>
          <span class="text-2xl" aria-hidden="true">
            <svg
              class="size-5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
            >
          </span>
        </button>
        <!-- End Arrows -->
      </div>

      <!-- Thumbnails -->
      <div class="flex-none sm:order-1">
        <div
          class="hs-carousel-pagination [&::-webkit-scrollbar-track]:bg-scrollbar-track [&::-webkit-scrollbar-thumb]:bg-scrollbar-thumb flex max-h-160 flex-row gap-2 overflow-x-auto sm:flex-col sm:overflow-x-hidden sm:overflow-y-auto [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-none"
        >
          {
            carrusel.map(items => (
              <div class="hs-carousel-pagination-item border-line-2 hs-carousel-active:border-primary width-full h-fit shrink-0 cursor-pointer overflow-hidden rounded-md border">
                <div class="flex h-fit items-center justify-center p-1 text-center">
                  <Image
                    src={items.ImagenArchivo}
                    alt={items.descripcion}
                    inferSize={false}
                    width={130}
                    height={70}
                    class="test rounded-md"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <!-- End Thumbnails -->
    </div>
  </div>
  <!-- End Carousel -->
</div>
<div class="mx-auto flex w-full justify-center">
  <Button variant="primary"> Ver en Detalle </Button>
</div>
