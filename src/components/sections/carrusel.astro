---
import Button from '@ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { getHomeContent, getLocaleFromUrl } from '@/i18n/content';
import { formatCatalogSpecValue } from '@utils/catalog-format';
import { withBase } from '@utils/links';

const locale = getLocaleFromUrl(Astro.url);
const { carrusel } = getHomeContent(locale);
type CarouselItem = {
  slug: string;
  titulo: string;
  descripcion: string;
  tipo: string;
  ImagenArchivo: string;
  Data: {
    Tamaño_del_boton: string;
    Longitud_del_tallo: string;
    Vida_en_florero: string;
    Numero_de_petalos: string;
    Estado_fenologico: string;
    Ciclo: string;
    link: string;
  };
};
const specRowClass =
  'grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] items-center gap-4 border-b border-slate-100 py-3';
const specLabelClass =
  'text-[10px] leading-tight font-bold tracking-wider text-slate-500 uppercase';
const specValueClass = 'text-right text-base font-semibold text-slate-900';
const labelsByLocale = {
  es: {
    badge: 'Seleccion premium',
    budSize: 'Tamano del boton',
    stemLength: 'Longitud de tallo',
    vaseLife: 'Vida en florero',
    petals: 'Numero de petalos',
    phenologicalStage: 'Estado fenologico',
    cycle: 'Ciclo',
    learnMore: 'Saber mas',
    viewDetail: 'Ver en detalle',
    previous: 'Anterior',
    next: 'Siguiente',
  },
  en: {
    badge: 'Premium selection',
    budSize: 'Bud size',
    stemLength: 'Stem length',
    vaseLife: 'Vase life',
    petals: 'Petal count',
    phenologicalStage: 'Phenological stage',
    cycle: 'Cycle',
    learnMore: 'Learn more',
    viewDetail: 'View in detail',
    previous: 'Previous',
    next: 'Next',
  },
  ru: {
    badge: 'Премиальная коллекция',
    budSize: 'Размер бутона',
    stemLength: 'Длина стебля',
    vaseLife: 'Стойкость в вазе',
    petals: 'Количество лепестков',
    phenologicalStage: 'Фенологическая стадия',
    cycle: 'Цикл',
    learnMore: 'Подробнее',
    viewDetail: 'Смотреть каталог',
    previous: 'Назад',
    next: 'Вперед',
  },
  zh: {
    badge: '精选品种',
    budSize: '花头尺寸',
    stemLength: '枝长',
    vaseLife: '瓶插寿命',
    petals: '花瓣数量',
    phenologicalStage: '生育周期',
    cycle: '周期',
    learnMore: '了解更多',
    viewDetail: '查看目录',
    previous: '上一张',
    next: '下一张',
  },
} as const;
const labels = labelsByLocale[locale];
---

<div class="mx-auto max-w-340 px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  <!-- Carousel -->
  <div
    data-carousel-root
    data-hs-carousel='{
    "isInfiniteLoop": true, "isAutoPlay": true, "isDraggable": true
  }'
    class="relative"
  >
    <div class="hs-carousel flex h-fit flex-col gap-2 sm:flex-row">
      <div
        class="relative min-h-[58rem] grow overflow-hidden rounded-lg sm:order-2 sm:min-h-[54rem] md:min-h-[42rem] lg:min-h-[40rem]"
      >
        <div
          class="hs-carousel-body absolute inset-s-0 top-0 bottom-0 flex flex-nowrap transition-transform duration-700"
        >
          {
            carrusel.map((entry, index: number) => {
              const items = entry as CarouselItem;

              return (
                <div class="hs-carousel-slide h-full">
                  <article class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl md:flex-row">
                    <div class="group relative w-full overflow-hidden bg-linear-to-br from-[#f7d2e3] via-white to-[#fdecef] md:w-1/2">
                    <img
                      src={withBase(items.ImagenArchivo) ?? ''}
                      alt={items.descripcion}
                      width={130}
                      height={70}
                      class="test h-auto w-full rounded-md"
                      />
                      <div class="absolute top-6 left-6">
                        <span class="rounded-full border border-slate-200 bg-white/90 px-3 py-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase backdrop-blur-sm">
                          {labels.badge}
                        </span>
                      </div>
                    </div>
                    <div class="flex w-full flex-1 flex-col justify-center bg-white p-8 md:w-1/2 md:p-12">
                      <header class="mb-8">
                        <h1 class="mb-2 text-4xl font-bold text-pink-600">
                          {items.titulo}
                        </h1>
                        <div class="flex items-center gap-2 text-slate-900">
                          <Icon name="MdiFlowerTulip" class="text-lg" />
                          <p class="text-xs font-bold tracking-[0.2em] uppercase">
                            {items.tipo}
                          </p>
                        </div>
                      </header>
                      <div class="flex flex-col">
                        <div class={specRowClass}>
                          <span class={specLabelClass}>{labels.budSize}</span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Tamaño_del_boton',
                              items.Data.Tamaño_del_boton
                            )}
                          </span>
                        </div>
                        <div class={specRowClass}>
                          <span class={specLabelClass}>
                            {labels.stemLength}
                          </span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Longitud_del_tallo',
                              items.Data.Longitud_del_tallo
                            )}
                          </span>
                        </div>
                        <div class={specRowClass}>
                          <span class={specLabelClass}>{labels.vaseLife}</span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Vida_en_florero',
                              items.Data.Vida_en_florero
                            )}
                          </span>
                        </div>
                        <div class={specRowClass}>
                          <span class={specLabelClass}>{labels.petals}</span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Numero_de_petalos',
                              items.Data.Numero_de_petalos
                            )}
                          </span>
                        </div>
                        <div class={specRowClass}>
                          <span class={specLabelClass}>
                            {labels.phenologicalStage}
                          </span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Estado_fenologico',
                              items.Data.Estado_fenologico
                            )}
                          </span>
                        </div>
                        <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] items-center gap-4 py-3">
                          <span class={specLabelClass}>{labels.cycle}</span>
                          <span class={specValueClass}>
                            {formatCatalogSpecValue(
                              locale,
                              'Ciclo',
                              items.Data.Ciclo
                            )}
                          </span>
                        </div>
                      </div>
                      <div class="mt-10 flex gap-3">
                        <Button
                          variant="alternative"
                          href={`/catalogo/${items.slug}`}
                        >
                          {' '}
                          {labels.learnMore}{' '}
                        </Button>
                      </div>
                    </div>
                  </article>
                </div>
              );
            })
          }
        </div>

        <!-- Arrows -->
        <button
          type="button"
          class="hs-carousel-prev hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default bg-layer text-layer-foreground hover:bg-layer-hover absolute inset-s-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full shadow-2xs focus:outline-hidden"
        >
          <span class="text-2xl" aria-hidden="true">
            <svg
              class="size-5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
            >
          </span>
          <span class="sr-only">{labels.previous}</span>
        </button>
        <button
          type="button"
          class="hs-carousel-next hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default bg-layer text-layer-foreground hover:bg-layer-hover absolute inset-e-2 top-1/2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full shadow-2xs focus:outline-hidden"
        >
          <span class="sr-only">{labels.next}</span>
          <span class="text-2xl" aria-hidden="true">
            <svg
              class="size-5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
            >
          </span>
        </button>
        <!-- End Arrows -->
      </div>

      <!-- Thumbnails -->
      <div class="flex-none sm:order-1">
        <div
          class="hs-carousel-pagination [&::-webkit-scrollbar-track]:bg-scrollbar-track [&::-webkit-scrollbar-thumb]:bg-scrollbar-thumb flex max-h-160 flex-row gap-2 overflow-x-auto sm:flex-col sm:overflow-x-hidden sm:overflow-y-auto [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-none"
        >
          {
            carrusel.map(entry => {
              const items = entry as CarouselItem;

              return (
                <div class="hs-carousel-pagination-item border-line-2 hs-carousel-active:border-primary width-full h-fit shrink-0 cursor-pointer overflow-hidden rounded-md border">
                  <div class="flex h-fit items-center justify-center p-1 text-center">
                  <img
                    src={withBase(items.ImagenArchivo) ?? ''}
                    alt={items.descripcion}
                    width={130}
                    height={70}
                    class="test rounded-md"
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
      <!-- End Thumbnails -->
    </div>
  </div>
  <!-- End Carousel -->
</div>
<div class="mx-auto flex w-full justify-center">
  <Button variant="primary" href="/catalogo"> {labels.viewDetail} </Button>
</div>

<script>
  const initCarousel = async () => {
    const root = document.querySelector('[data-carousel-root]');
    if (!root) return;

    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();

    requestAnimationFrame(() => {
      HSStaticMethods.autoInit();
    });
  };

  document.addEventListener('astro:page-load', initCarousel);
  document.addEventListener('DOMContentLoaded', initCarousel);
  window.addEventListener('load', initCarousel);
</script>
