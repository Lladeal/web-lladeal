---
import Button from '@ui/Button.astro';
import { call_to_action } from '@content/pages/home.json'
---

<section
  class="mx-auto max-w-340 px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
    <h2 class="text-4xl text-balance text-slate-800 sm:text-5xl">
      <Fragment set:html={call_to_action.titulo} />
    </h2>
    <p class="text-lg\/8 mt-5 text-pretty text-slate-600">
      {call_to_action.subtitulo}
    </p>
    <Button
      href={call_to_action.boton.link}
      variant="primary"
      className="mt-7 inline-flex border-none px-3.5!">{call_to_action.boton.titulo}</Button
    >
  </div>
</section>
