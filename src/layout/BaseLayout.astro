---
import Navbar from '@sections/Navbar.astro';
import Footer from '@sections/Footer.astro';
import WhatsappBtn from '@common/whatsBtn.astro';
import { ClientRouter } from 'astro:transitions';
import { SEO, type Props as SEOProps } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import type { WithContext, Thing } from 'schema-dts';
import { withBase } from '@utils/links';
import { localeMetadata } from '@/i18n/config';
import { getLocaleFromUrl, getSeoContent } from '@/i18n/content';
import '@styles/global.css';

interface Props {
  seo?: SEOProps; // Optional SEO properties to customize meta tags
  schema?: WithContext<Thing>; // Optional schema.org properties for structured data
}

// Extract `seo` and `schema` from properties or define defaults
const { seo, schema } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const localeMeta = localeMetadata[locale];
const seoContent = getSeoContent(locale);
const { Seo_global } = seoContent;
const socialImage = new URL(
  withBase('/social.png') ?? '/social.png',
  Astro.site
).toString();
const somatypeBold = withBase('/fonts/Somatype-Bold.otf');

// Define default JSON-LD Schema.org data if no schema is passed
const defaultSchema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: localeMeta.schemaLang,
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: Seo_global.titulo,
  description: Seo_global.descripcion,
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: Seo_global.titulo,
    description: Seo_global.descripcion,
  },
};
---

<html lang={localeMeta.htmlLang} class="scroll-pt-32">
  <head>
    {/* SEO Meta Tags */}
    <SEO
      charset="utf-8"
      title={Seo_global.titulo}
      description={Seo_global.descripcion}
      openGraph={{
        basic: {
          title: Seo_global.og_titulo,
          type: 'website',
          image: socialImage,
        },
        optional: {
          description: Seo_global.og_descripcion,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: Seo_global.og_titulo,
        description: Seo_global.og_descripcion,
        image: socialImage,
        imageAlt: Seo_global.imagen_texto_alternativo,
      }}
      extend={{
        link: [
          { rel: 'icon', href: withBase('/icon.svg'), type: 'image/svg+xml' },
          { rel: 'apple-touch-icon', href: withBase('/apple-touch-icon.png') },
          { rel: 'manifest', href: withBase('/manifest.webmanifest') },
        ],
        meta: [
          { name: 'viewport', content: 'width=device-width' },
          { name: 'generator', content: `${Astro.generator}` },
        ],
      }}
    />
    {/* Schema.org JSON-LD */}
    <Schema item={schema ?? defaultSchema} />

    {/* Client-Side Router for page transitions */}
    <ClientRouter />

    {/* Local Font Definitions */}
    <link
      rel="preload"
      href={somatypeBold}
      as="font"
      type="font/otf"
      crossorigin
    />
    <style
      is:global
      define:vars={{
        somatypeBold,
      }}
    >
      @font-face {
        font-family: 'DM Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'DM Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'DM Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 900;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Work Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Work Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Work Sans';
        src: url(var(--somatypeBold)) format('opentype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    </style>

    {/* Remove duplicate font links during transitions */}
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      document.addEventListener('astro:before-swap', e =>
        [
          ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
            'link[as="font"]'
          ),
        ].forEach(link => link.remove())
      );
    </script>
  </head>
  <body class="bg-off-white selection:bg-[#7e2c75] selection:text-white">
    <Navbar />

    <main>
      <slot />
      <WhatsappBtn />
    </main>

    <Footer />
  </body>
</html>
