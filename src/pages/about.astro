---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import type { WithContext, Thing } from 'schema-dts';
import { Icon } from 'astro-icon/components';
import { withBase } from '@utils/links';
import {
  getAboutContent,
  getLocaleFromUrl,
  getSeoContent,
} from '@/i18n/content';
import { getUiStrings } from '@/i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
const { sobre_nosotros, seo_sobre_nosotros } = getSeoContent(locale);
const { datos_sobre_nosotros, datos_de_experticie, Team, mision_vison } =
  getAboutContent(locale);
const t = getUiStrings(locale).footer;

// Schema.org metadata for SEO
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: `${sobre_nosotros.lenguaje}`,
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: `${sobre_nosotros.nombre}`,
  description: `${sobre_nosotros.descripcion}`,
  isPartOf: {
    '@type': 'WebPage',
    url: `${Astro.site}`,
    name: `${sobre_nosotros.parte_de.nombre}`,
    description: `${sobre_nosotros.parte_de.descripcion}`,
  },
};
---

<BaseLayout seo={seo_sobre_nosotros} schema={schema}>
  <section class="mx-auto max-w-340 px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h1
          class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {datos_sobre_nosotros.titulo}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {datos_sobre_nosotros.descripcion}
        </p>
      </div>

      {/* Statistics Section */}
      <div class="mx-auto mt-10 max-w-2xl lg:mx-0 lg:max-w-none">
        <dl
          class="mt-16 grid grid-cols-1 gap-8 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            datos_sobre_nosotros.estadisticas.map(stat => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-base/7 text-slate-700">{stat.texto}</dt>
                <dd class="text-4xl font-semibold tracking-tight text-slate-800">
                  {stat.valor}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Expertise Section */}
  <section class="mx-auto max-w-340 px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="group relative isolate overflow-hidden rounded-3xl bg-[#e3186d]/10 p-5 sm:p-11"
    >
      <div
        class="group pointer-events-none absolute inset-0 -top-[10%] h-[120%] w-full rounded-xl bg-linear-to-r/oklch from-[#e3186d]/20 to-[#181c37]/2 opacity-0 transition duration-1000 group-hover:opacity-100"
      >
      </div>
      <div class="svgBlock mx-auto max-w-7xl">
        <h2
          class="relative pl-4 text-2xl font-semibold text-balance text-slate-900 md:text-3xl md:leading-tight"
        >
          {datos_de_experticie.titulo}
        </h2>
        <dl
          class="relative mt-10 grid max-w-xl grid-cols-1 items-start text-base/7 text-slate-800 sm:max-w-none lg:grid-flow-row-dense lg:auto-rows-fr lg:grid-cols-3"
        >
          {
            datos_de_experticie.experticie.map((item, index) => (
              <div
                class={`px-5 py-5 sm:px-10 lg:py-0 ${index === 1 ? 'h-full border-y border-dashed border-slate-400 lg:border-x lg:border-y-0' : ''}`}
              >
                <dt class="text-lg font-semibold text-balance text-slate-800">
                  {item.titulo}
                </dt>
                <dd class="mt-2 text-pretty text-slate-700">
                  {item.descripcion}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-340 px-4 pb-12 pb-24 sm:px-6 lg:px-8">
    <!-- Team -->
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <!-- Title -->
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2
          class="text-foreground text-2xl font-bold text-slate-800 md:text-4xl md:leading-tight"
        >
          {Team.titulo}
        </h2>
        <p class="text-muted-foreground-2 mt-1 text-slate-700">
          {Team.descripcion}
        </p>
      </div>
      <!-- End Title -->

      <!-- Grid -->
      <div
        class="flex flex-wrap gap-10 justify-center"
      >
        {
          Team.team.map(miembro => (
            <div class="text-center">
              <img
                class="mx-auto size-24 rounded-full"
                src={
                  !miembro.foto
                    ? withBase('/uploads/fotos_personal/Avatar-default.png')
                    : withBase(miembro.foto)
                }
                alt={`${t.avatarAlt} ${miembro.nombre}`}
                width={96}
                height={96}
              />
              <div class="mt-2 sm:mt-4">
                <h3 class="text-foreground font-medium">{miembro.nombre}</h3>
                <p class="text-muted-foreground-2 text-sm">{miembro.cargo}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <!-- End Team -->
  </section>

  <!-- vision mision -->
  <!-- Icon Blocks -->
  <section
    class="mx-auto flex md:flex-row flex-col max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
  >
    <div class="md:w-1/2 border-y border-dashed border-slate-400 lg:border-x lg:border-y-0 p-8">
      <!-- Grid -->
      <div class="grid gap-12">
        <div>
          <h2 class="text-foreground text-3xl font-bold lg:text-4xl">
            {mision_vison.mision.titulo}
          </h2>
          <p class="text-foreground mt-3">
            {mision_vison.mision.descripcion}
          </p>
        </div>

        <div class="space-y-6 lg:space-y-10">
          {
            mision_vison.mision.lista.map(lista => (
              <div class="flex gap-x-5 rounded-2xl from-transparent to-[#e3186d]/20 p-2 transition-all delay-110 hover:translate-2 hover:bg-linear-to-b sm:gap-x-8">
                <Icon
                  name={lista.icono}
                  class="text-foreground mt-2 size-6 shrink-0"
                />
                <div class="grow">
                  <h3 class="text-foreground text-base font-semibold sm:text-lg">
                    {lista.title}
                  </h3>
                  <p class="text-muted-foreground-2 mt-1">{lista.label}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <!-- End Grid -->
    </div>
    <div class="md:w-1/2 border-y border-dashed border-slate-400 lg:border-x lg:border-y-0 p-8">
      <!-- Grid -->
      <div class="grid gap-12">
        <div>
          <h2 class="text-foreground text-3xl font-bold lg:text-4xl">
            {mision_vison.vision.titulo}
          </h2>
          <p class="text-foreground mt-3">
            {mision_vison.vision.descripcion}
          </p>
        </div>

        <div class="space-y-6 lg:space-y-10">
          {
            mision_vison.vision.lista.map(lista => (
              <div class="flex gap-x-5 rounded-2xl from-transparent to-[#e3186d]/20 p-2 transition-all delay-110 hover:translate-2 hover:bg-linear-to-b sm:gap-x-8">
                <Icon
                  name={lista.icono}
                  class="text-foreground mt-2 size-6 shrink-0"
                />
                <div class="grow">
                  <h3 class="text-foreground text-base font-semibold sm:text-lg">
                    {lista.title}
                  </h3>
                  <p class="text-muted-foreground-2 mt-1">{lista.label}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <!-- End Grid -->
    </div>
  </section>
  <!-- End Icon Blocks -->

  

  <style
    define:vars={{
      guillocheBg: `url(${import.meta.env.BASE_URL}guilloche.svg)`,
    }}
  >
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--guillocheBg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
