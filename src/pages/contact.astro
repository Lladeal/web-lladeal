---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import ContactForm from '@ui/forms/ContactForm.astro';
import type { WithContext, Thing } from 'schema-dts';
import { withBase } from '@utils/links';
import {
  getContactContent,
  getLocaleFromUrl,
  getNavbarContent,
  getSeoContent,
} from '@/i18n/content';

const locale = getLocaleFromUrl(Astro.url);
const { contactos } = getContactContent(locale);
const { seo_contactos, seo_contact } = getSeoContent(locale);
const { barra_de_navegacion } = getNavbarContent(locale);

// Schema.org metadata for SEO
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  inLanguage: `${seo_contactos.lenguaje}`,
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: `${seo_contactos.nombre}`,
  description: `${seo_contactos.description}`,
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: `${seo_contactos.parte_de.nombre}`,
    description: `${seo_contactos.parte_de.descripcion}`,
  },
};
---

<BaseLayout seo={seo_contact} schema={schema}>
  <div class="mx-auto max-w-340 px-4 pt-48 pb-28 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl lg:mb-14">
      <h2
        class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {contactos.titulo}
      </h2>
      <p class="mt-1 ml-1 text-slate-600">{contactos.subtitulo}</p>
    </div>

    <div class="grid grid-cols-1 gap-x-10 md:grid-cols-2 lg:gap-x-16 ">
      <div class="space-y-14 self-center rounded-2xl p-10 relative overflow-hidden rounded-2xl border border-white/35 bg-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_10px_30px_rgba(0,0,0,0.12)] backdrop-blur-2xl backdrop-saturate-150 before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(135deg,rgba(255,255,255,0.45),rgba(255,255,255,0.12)_40%,rgba(255,255,255,0.03))] after:pointer-events-none after:absolute after:top-2 after:right-2 after:h-10 after:w-10 after:rounded-full after:bg-white/30 after:blur-xl h-full w-full hover:scale-105 transition-all">
        <div class="flex gap-x-5">
          <Icon name="mapPin" />
          <div class="grow">
            <h4 class="font-semibold text-slate-800">
              {contactos.direcciones.titulo}
            </h4>

            <address class="mt-1 text-sm text-slate-800 not-italic">
              {contactos.direcciones.direccion_1}
              <br />
              {contactos.direcciones.direccion_2}
            </address>
          </div>
        </div>

        <div class="flex gap-x-5">
          <Icon name="email" class="size-6 shrink-0 text-slate-800" />
          <div class="grow">
            <h4 class="font-semibold text-slate-800">
              {contactos.correo.titulo}
            </h4>

            <a
              class="mt-1 text-sm text-slate-800 transition-colors duration-300 hover:text-slate-700 focus:text-slate-400 focus:outline-hidden"
              href={`mailto:${contactos.correo.mail}`}
            >
              {contactos.correo.mail}
            </a>
          </div>
        </div>

        <div class="flex gap-x-5">
          <Icon name="info" class="size-6 shrink-0 text-slate-800" />
          <div class="grow">
            <h4 class="font-semibold text-slate-800">
              {contactos.blog.titulo}
            </h4>
            <p class="mt-1 text-sm text-slate-800">
              {contactos.blog.detalles.descripcion}
            </p>
            <p class="mt-2">
              <a
                class="group inline-flex items-center gap-x-2 text-sm font-medium text-slate-800 decoration-2 transition duration-300 hover:underline focus:underline focus:outline-hidden"
                href={withBase(contactos.blog.detalles.link, locale)}
              >
                {contactos.blog.detalles.texto}
                <Icon name="chevronRight" />
              </a>
            </p>
          </div>
        </div>
      </div>
      <div class="space-y-14 self-center rounded-2xl p-10 relative overflow-hidden rounded-2xl border border-white/35 bg-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_10px_30px_rgba(0,0,0,0.12)] backdrop-blur-2xl backdrop-saturate-150 before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(135deg,rgba(255,255,255,0.45),rgba(255,255,255,0.12)_40%,rgba(255,255,255,0.03))] after:pointer-events-none after:absolute after:top-2 after:right-2 after:h-10 after:w-10 after:rounded-full after:bg-white/30 after:blur-xl h-full w-full hover:scale-105 transition-all">
        <div class="flex flex-col justify-center items-start mb-2">
          <h4
            class="text-2xl text-balance text-slate-800 sm:text-4xl md:text-4xl lg:text-4xl"
          >
            {contactos.titulo_form}
          </h4>
          <p class="mt-1 ml-1 text-slate-600">{contactos.descripcion_form}</p>
        </div>
        <div
          class="mb-10 h-fit rounded-2xl bg-[#e0e0e0] shadow-[inset_20px_20px_60px_#bebebe,inset_-20px_-20px_60px_#ffffff] pb-10 md:order-2 md:mb-0 md:pb-0 "
        >
          <ContactForm />
        </div>
      </div>
    </div>
  </div>

  <script>
    // Automatically adjusting the height of the textarea
    // based on its content. Triggers when the textarea content changes.
    document.addEventListener('astro:page-load', () => {
      function textareaAutoHeight(
        el: HTMLTextAreaElement,
        offsetTop: number = 0
      ): void {
        el.style.height = 'auto';
        el.style.height = `${el.scrollHeight + offsetTop}px`;
      }

      (() => {
        const textareas: string[] = ['#input-message'];

        textareas.forEach(selector => {
          const textarea = document.querySelector(
            selector
          ) as HTMLTextAreaElement;

          if (!textarea) return;

          const overlay = textarea.closest('.hs-overlay');

          if (overlay) {
            const instance = (window as any).HSOverlay.getInstance(
              overlay,
              true
            );

            if (instance) {
              instance.element.on('open', () =>
                textareaAutoHeight(textarea, 3)
              );
            }
          } else {
            textareaAutoHeight(textarea, 3);
          }

          textarea.addEventListener('input', () => {
            textareaAutoHeight(textarea, 3);
          });
        });
      })();
    });
  </script>
</BaseLayout>
