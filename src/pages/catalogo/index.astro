---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Catalogo';
const title = 'Revisa nuestro catalogo de flores';
const subTitle =
  "The DataNova Core comes in two editions: Essential and Advanced. Choose the one that fits your goals to unlock your data's full potential. Upgrading is simple when you're ready to grow.";

// Comparison Table Link
const compareLinkTitle = 'Compare editions & features';
const compareLink = 'editions';
const compareLinkAriaLabel =
  'Explore the detailed feature comparison of the Essential and Advanced Editions of DataNova Core.';



---

<BaseLayout>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
        <h1
          class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 max-w-xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {subTitle}
        </p>
        <a
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden"
          href={compareLink}
          target="_blank"
          aria-label={compareLinkAriaLabel}
        >
          {compareLinkTitle}
          <Icon name="chevronRight" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-40 pb-12 sm:px-6 lg:px-8"
  >
    <div class="gap-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1: Form Study Lab -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="A high-end macro photograph of a pink Magic Time rose with vibrant magenta and deep navy tones. The lighting is soft yet high-contrast, highlighting the complex geometry of the petals in a minimalist scientific aesthetic. The composition is clean and modern, evoking botanical precision."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDhjHbjyZGuBeggJ1Sc56dyXAAU288DDTM0zlftnRPpKDD77zpT6XHOj5GyZfUIOfgBdporumkE3k7RHkVmLtFBfcU9mkggC1KBanmbdNgKNe4BvGJIQ8jqvXQV3UBiaC1-A2VAGuBn5JU7FlhrOhSm5OkjA236eCKOFEG7eGYme6I8Pur-wYhmiOSy2DDSyMU0kiIOuCOH0abGOjG-8Nn6zKhho6EsU5SqS3rOTvJpZU6heWgXBNnO6UgkKzk6s-2Clh2KY_sQe7Y"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Form</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              Form Study Lab
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Explore bold 3D compositions inspired by petal fractals and
              organic growth cycles.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
        <!-- Card 2: Orbital Motion -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="Abstract digital rendering of glowing pink and magenta light trails orbiting a dark central axis. The aesthetic is clean and surgical, representing biological energy flows. Deep slate backgrounds contrast with the intense neon-like botanical energy trails."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDmZeLGM4Xof-xnXFjgA0daZd1vQfCeXqO99oBg7ghLV7WeQ6YKxin9Ep9QR3NnblH9oM75WVPp0-nHRlsDWhVoHgoY_B92qV3lSetw06yTnhcOQZcgh4V5pqHVlGj79ctSdcNCdMoqBnmaXpJhGTeLjNXuuv4J9bMdckPyQBCswibKFdZYGdhw25dCFzKmce84eU8RZNzOZiZrz5BG3sHUf_bw_QrA-NtoRRVIJENaz24ooUp_e5eH60_IMxoFNIJQB35Ggu5IT-M"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Orbit</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              Orbital Motion
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Generate cosmic visuals and energy maps centered on floral pollen
              dispersal patterns.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
        <!-- Card 3: Light Trail Studio -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="A soft-focus abstract composition of warm golden and vibrant magenta light. The lighting creates a high-fidelity botanical glow, reminiscent of sunrise over a glass greenhouse. Minimalist lines cut through the colors to suggest structural plant cells."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDzd0mlIs7sQjUJoCpiypgnxDQFUduQB1qmS1y1wskKpttDr2WyYmc-747i1_-lV9tZTj_EGlj-BGDSN4Ig81JCRHpxdGvbShm6qhdNfawQTyz1uWe6c4YDZqwpMgvxyGWqQ-p4dI1eJ4PWdv6SWt9seFlx6LzGqcYarq7NlAULW0_3D3qSslHWFzTPUUwkMgdUNv9yKEERv2OQ9vgLC9xDTXQlF-tNue4_PMGzbMO2U3inwFELoI6AYABp-iegLoVoQMuKpgPSwTs"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Trail</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              Light Trail Studio
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Create abstract motion scenes reflecting the phototropism of
              high-altitude flora.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
        <!-- Card 4: Modular Blocks -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="3D isometric grid of golden and magenta blocks on a deep navy background. The lighting is precise and architectural, echoing the modular structure of stem cells and seed pods. A minimalist, sophisticated aesthetic with high color saturation."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuARgwqy7KeSjJlAXD6c8uI4xCMRngo86dbexu5IMMFIYDgKnpQSm3zx4gmM6YP-XUMheAyeBZt502c0CfGdZlrGyqygIcDMIZBoRHeujSfffH8YQtyxiIX2AHAp7FslW-pLKU0IcRAnIXPZQXOmneVGL2X0Bl9vlLa54LFHtzMKlN1pPHra7wwAkbb8UGaMbHw2j8dmsHWBRmsQ2XnQmqJGL2GVfCO6NRayuWyW_uHnlg19caxi3dGpB1m8UK-evQuvasYSrlvErW8"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Grid</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              Modular Blocks
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Design structured systems and stacked growth patterns for future
              greenhouse architecture.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
        <!-- Card 5: World Atlas -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="A vintage globe focused on botanical hotspots, overlaid with digital magenta heatmaps. The image blends historical documentation with modern scientific analysis. Muted earth tones are punctuated by sharp pink digital overlays for a premium feel."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLdoaBIZoJLpEBLhbZUDFa5JDwMqTrlc86X7k1XQ0zER6I3q6GCxN76f8lvUFCOp-hE-6XTB70Gb2TYchH0-7CbOyk0kaPvybIPugSz8F94THcSox70MX0tZ2sfMjP-QDg8d628Tub5gZLYLyRwSV4TnAfmCBgKeInOgLC4ea5fyRlPtKphCHwSvftke0-6WYeeVVgRHU21tY93_5NwgBjXO6ZBCx1nY_Re4R-UvqsHeAW8T9r-FM62FnZhpIxo1OdY1GzCW4W4g0"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Atlas</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              World Atlas
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Build geography-driven content maps based on global rare flower
              migration data.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
        <!-- Card 6: Soft Geometry -->
        <div
          class="botanical-shadow group overflow-hidden rounded-xl bg-[#0f172a] transition-transform duration-300 hover:-translate-y-2"
        >
          <div class="h-64 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              data-alt="Minimalist 3D objects with soft, organic shapes in pastel pink and translucent textures. The scene is illuminated by clean, studio-white light against a dark slate-navy background. It represents the microscopic textures of flower petals and succulents."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQ7cSOdN2c5-x9Q1siIoDgAsfyXDvD7v5Ba3ShMK3vAqnqvO7mKGD6oBacZo88r1GKJlVrT0Nh6wtgsd2u12DFN8jzbBTcQco2vU9odRLQgpztPKQyXiOt1AE1FFJN05lt8ZhavrAjtoVwp7H57PTtnVQvJmms--CMZf1xtivMQv-sSxmVYBHMU7_XtwGgQ0iBb61ki2dXIHL0yxXu6xjbeSy56nHDtJor0JiaxUGC1emNaszIQfWtXX1X3bnVXwth73anfe4dlCw"
            />
          </div>
          <div class="p-gutter">
            <div class="mb-2 flex items-center gap-2">
              <span class="bg-secondary h-2 w-2 rounded-full"></span>
              <span
                class="font-label-md text-label-md text-secondary-fixed-dim tracking-tighter uppercase"
                >By Shape</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-2 text-white">
              Soft Geometry
            </h3>
            <p class="font-body-md text-on-primary-container mb-gutter">
              Prototype playful 3D objects and soft-shell structures derived
              from succulent leaves.
            </p>
            <button
              class="bg-secondary px-gutter font-label-md text-label-md hover:bg-secondary-container rounded-lg py-2 text-white transition-colors duration-200"
              >Research Data</button
            >
          </div>
        </div>
      </div>
  </section>

  <style
    define:vars={{
      guillocheBg: `url(${import.meta.env.BASE_URL}guilloche.svg)`,
    }}
  >
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--guillocheBg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
