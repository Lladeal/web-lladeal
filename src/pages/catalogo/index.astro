---
export const prerender = true;

import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import {
  getCatalogContent,
  getHomeContent,
  getLocaleFromUrl,
} from '@/i18n/content';
import { withBase } from '@utils/links';

const locale = getLocaleFromUrl(Astro.url);
const { hero, listing, seo } = getCatalogContent(locale);
const { carrusel } = getHomeContent(locale);
const itemsPerPage = 9;
const totalPages = Math.ceil(carrusel.length / itemsPerPage);
type CatalogItem = (typeof carrusel)[number];
const catalogItems = carrusel as CatalogItem[];
const catalogTypes: string[] = [];

for (const item of catalogItems) {
  if (typeof item.tipo !== 'string' || item.tipo.length === 0) continue;
  if (!catalogTypes.includes(item.tipo)) {
    catalogTypes.push(item.tipo);
  }
}

catalogTypes.sort((a: string, b: string) => a.localeCompare(b, locale));
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-3xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{hero.preTitle}</p>
        <h1
          class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {hero.title}
        </h1>
        <p
          class="mt-8 max-w-2xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {hero.subTitle}
        </p>
        <a
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden"
          href={withBase(hero.linkHref, locale)}
          aria-label={hero.linkAriaLabel}
        >
          {hero.linkTitle}
        </a>
        <Button
          href={withBase(hero.linkhref2, locale)}
          target="_blank"
          className="ml-5 inline-flex border-none px-4! py-2.5!"
          download
        >
          {hero.linktitle2}
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-24 sm:px-6 lg:px-8">
    {
      catalogTypes.length > 0 && (
        <div class="mb-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
              <p class="text-sm font-semibold tracking-[0.16em] text-pink-600 uppercase">
                {listing.filterTitle}
              </p>
              <p class="mt-2 text-sm text-slate-500">{listing.typeLabel}</p>
            </div>

            <button
              type="button"
              class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
              data-clear-filters
            >
              {listing.clearFilters}
            </button>
          </div>

          <div class="mt-5 flex flex-wrap gap-3" data-catalog-filters>
            {
              catalogTypes.map((type: string) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-pink-300 hover:bg-pink-50">
                  <input
                    type="checkbox"
                    value={type}
                    class="size-4 rounded border-slate-300 text-[#e3186d] focus:ring-transparent"
                    data-filter-checkbox
                  />
                  <span>{type}</span>
                </label>
              ))
            }
          </div>
        </div>
      )
    }

    <div id="catalog-grid" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        carrusel.map((item: CatalogItem, index: number) => (
          <article
            class={`group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl ${index >= itemsPerPage ? 'hidden' : ''}`}
            data-catalog-item
            data-type={item.tipo}
          >
            <div class="bg-linear-to-br from-[#f7d2e3] via-white to-[#fdecef] p-6">
              <img
                src={index < itemsPerPage ? withBase(item.ImagenArchivo) : undefined}
                data-src={withBase(item.ImagenArchivo) ?? ''}
                alt={item.descripcion}
                width={640}
                height={780}
                loading={index < itemsPerPage ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index < itemsPerPage ? 'high' : 'low'}
                class="mx-auto h-72 w-auto object-contain"
              />
            </div>
            <div class="space-y-4 p-6">
              <div>
                <p class="text-xs font-semibold tracking-[0.16em] text-pink-600 uppercase">
                  {listing.typeLabel}
                </p>
                <p class="mt-1 text-sm font-medium text-slate-500 uppercase">
                  {item.tipo}
                </p>
              </div>
              <div>
                <h2 class="text-2xl font-semibold text-slate-800">
                  {item.titulo}
                </h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                  {item.descripcion}
                </p>
              </div>
              <Button
                href={`/catalogo/${item.slug}`}
                className="inline-flex border-none px-4! py-2.5!"
                ariaLabel={`${listing.button}: ${item.titulo}`}
              >
                {listing.button}
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav
          class="mt-10 flex flex-wrap items-center justify-center gap-3"
          aria-label={listing.paginationLabel}
          data-catalog-pagination
        >
          <button
            type="button"
            class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-40"
            data-page-prev
            disabled
          >
            {listing.previous}
          </button>

          <div class="flex flex-wrap items-center justify-center gap-2">
            {
              Array.from({ length: totalPages }, (_, index) => {
                const page = index + 1;

                return (
                  <button
                    type="button"
                    class={`size-11 rounded-full border text-sm font-semibold transition ${
                      page === 1
                        ? 'border-pink-600 bg-pink-600 text-[#e3186d]'
                        : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:text-slate-900'
                    }`}
                    aria-current={page === 1 ? 'page' : undefined}
                    data-page-button={page}
                  >
                    {page}
                  </button>
                );
              })
            }
          </div>

          <button
            type="button"
            class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-40"
            data-page-next
            disabled={totalPages === 1}
          >
            {listing.next}
          </button>
        </nav>
      )
    }
  </section>
</BaseLayout>

<script is:inline define:vars={{ totalPages, itemsPerPage }}>
  (() => {
    const initCatalogPagination = () => {
      const pagination = document.querySelector('[data-catalog-pagination]');
      const cards = Array.from(document.querySelectorAll('[data-catalog-item]'));
      const filterInputs = Array.from(
        document.querySelectorAll('[data-filter-checkbox]')
      );
      const clearFiltersButton = document.querySelector('[data-clear-filters]');

      if (!cards.length) return;
      if (pagination && pagination.dataset.bound === 'true') return;
      if (pagination) pagination.dataset.bound = 'true';

      const prevButton = pagination?.querySelector('[data-page-prev]');
      const nextButton = pagination?.querySelector('[data-page-next]');
      const pageButtons = Array.from(
        pagination?.querySelectorAll('[data-page-button]') ?? []
      );

      let currentPage = 1;
      let activeTypes = [];

      const ensureCardImage = card => {
        const image = card.querySelector('img[data-src]');
        if (!(image instanceof HTMLImageElement)) return;
        if (image.dataset.loaded === 'true') return;

        const src = image.getAttribute('data-src');
        if (!src) return;

        image.src = src;
        image.dataset.loaded = 'true';
      };

      const getFilteredCards = () => {
        if (!activeTypes.length) return cards;
        return cards.filter(card => activeTypes.includes(card.getAttribute('data-type')));
      };

      const updateFilterStyles = () => {
        filterInputs.forEach(input => {
          if (!(input instanceof HTMLInputElement)) return;
          const label = input.closest('label');
          if (!label) return;
          label.classList.toggle('border-pink-300', input.checked);
          label.classList.toggle('bg-pink-50', input.checked);
          label.classList.toggle('text-pink-700', input.checked);
        });
      };

      const renderPage = page => {
        const filteredCards = getFilteredCards();
        const filteredTotalPages = Math.max(
          1,
          Math.ceil(filteredCards.length / itemsPerPage)
        );

        currentPage = Math.min(Math.max(page, 1), filteredTotalPages);

        cards.forEach(card => {
          const isVisibleByFilter = filteredCards.includes(card);
          if (!isVisibleByFilter) {
            card.classList.add('hidden');
            return;
          }

          const cardIndex = filteredCards.indexOf(card);
          const cardPage = Math.floor(cardIndex / itemsPerPage) + 1;
          const isVisible = cardPage === currentPage;
          card.classList.toggle('hidden', !isVisible);

          if (isVisible) {
            ensureCardImage(card);
          }
        });

        if (pagination) {
          pagination.classList.toggle('hidden', filteredCards.length <= itemsPerPage);
        }

        pageButtons.forEach(button => {
          const buttonPage = Number(button.getAttribute('data-page-button'));
          const isActive = buttonPage === currentPage;
          const shouldHide = buttonPage > filteredTotalPages;

          button.classList.toggle('hidden', shouldHide);
          if (shouldHide) {
            button.removeAttribute('aria-current');
            return;
          }

          if (isActive) {
            button.setAttribute('aria-current', 'page');
          } else {
            button.removeAttribute('aria-current');
          }
          button.classList.toggle('border-pink-600', isActive);
          button.classList.toggle('bg-pink-600', isActive);
          button.classList.toggle('text-[#e3186d]', isActive);
          button.classList.toggle('border-slate-200', !isActive);
          button.classList.toggle('bg-white', !isActive);
          button.classList.toggle('text-slate-700', !isActive);
        });

        if (prevButton instanceof HTMLButtonElement) {
          prevButton.disabled = currentPage === 1;
        }

        if (nextButton instanceof HTMLButtonElement) {
          nextButton.disabled = currentPage === filteredTotalPages;
        }
      };

      const syncFilters = () => {
        activeTypes = filterInputs
          .filter(input => input instanceof HTMLInputElement && input.checked)
          .map(input => input.value);

        updateFilterStyles();
        renderPage(1);
      };

      pageButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const targetPage = Number(button.getAttribute('data-page-button'));
          if (!targetPage || targetPage === currentPage) return;
          renderPage(targetPage);
          document
            .querySelector('#catalog-grid')
            ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.addEventListener('click', () => {
          if (currentPage > 1) {
            renderPage(currentPage - 1);
            document
              .querySelector('#catalog-grid')
              ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.addEventListener('click', () => {
          if (currentPage < totalPages) {
            renderPage(currentPage + 1);
            document
              .querySelector('#catalog-grid')
              ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      filterInputs.forEach(input => {
        if (!(input instanceof HTMLInputElement)) return;
        input.addEventListener('change', syncFilters);
      });

      if (clearFiltersButton instanceof HTMLButtonElement) {
        clearFiltersButton.addEventListener('click', () => {
          filterInputs.forEach(input => {
            if (input instanceof HTMLInputElement) {
              input.checked = false;
            }
          });

          syncFilters();
        });
      }

      updateFilterStyles();
      renderPage(1);
    };

    initCatalogPagination();
    document.addEventListener('astro:page-load', initCatalogPagination);
  })();
</script>
