---
export const prerender = true;

import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import { Image } from 'astro:assets';
import { getCatalogContent, getHomeContent, getLocaleFromUrl } from '@/i18n/content';
import { withBase } from '@utils/links';

const locale = getLocaleFromUrl(Astro.url);
const { hero, listing, seo } = getCatalogContent(locale);
const { carrusel } = getHomeContent(locale);

function slugify(value: string) {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

type CatalogItem = (typeof carrusel)[number];
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-3xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{hero.preTitle}</p>
        <h1 class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">
          {hero.title}
        </h1>
        <p class="mt-8 max-w-2xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">
          {hero.subTitle}
        </p>
        <a
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden"
          href={withBase(hero.linkHref, locale)}
          aria-label={hero.linkAriaLabel}
        >
          {hero.linkTitle}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-24 sm:px-6 lg:px-8">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        carrusel.map((item: CatalogItem) => (
          <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="bg-linear-to-br from-[#f7d2e3] via-white to-[#fdecef] p-6">
              <Image
                src={item.ImagenArchivo}
                alt={item.descripcion}
                inferSize={false}
                width={640}
                height={780}
                class="mx-auto h-72 w-auto object-contain"
              />
            </div>
            <div class="space-y-4 p-6">
              <div>
                <p class="text-xs font-semibold tracking-[0.16em] text-pink-600 uppercase">
                  {listing.typeLabel}
                </p>
                <p class="mt-1 text-sm font-medium text-slate-500 uppercase">{item.tipo}</p>
              </div>
              <div>
                <h2 class="text-2xl font-semibold text-slate-800">{item.titulo}</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">{item.descripcion}</p>
              </div>
              <Button href={`/catalogo/${slugify(item.titulo)}`} className="inline-flex border-none px-4! py-2.5!">
                {listing.button}
              </Button>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
