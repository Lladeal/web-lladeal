---
export const prerender = true;

import CatalogDetailPage from '../../components/pages/CatalogDetailPage.astro';
import { getHomeContent } from '@/i18n/content';

type CatalogItem = {
  slug: string;
  titulo: string;
  descripcion: string;
  tipo: string;
  ImagenArchivo: string;
  Data: {
    Tamaño_del_boton: string;
    Longitud_del_tallo: string;
    Vida_en_florero: string;
    Numero_de_petalos: string;
    Estado_fenologico: string;
    Ciclo: string;
    link: string;
  };
};

export function getStaticPaths() {
  const items = getHomeContent('es').carrusel as CatalogItem[];

  return items.map(item => ({
    params: { id: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: CatalogItem };
---

<CatalogDetailPage item={item} />
