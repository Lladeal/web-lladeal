---
export const prerender = true;

import CatalogDetailPage from '../../components/pages/CatalogDetailPage.astro';
import homeEs from '@content/pages/home.json';

type CatalogItem = (typeof homeEs.carrusel)[number];

export function getStaticPaths() {
  const slugify = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  return homeEs.carrusel.map((item: CatalogItem) => ({
    params: { id: slugify(item.titulo) },
    props: { item },
  }));
}

const { item } = Astro.props as { item: CatalogItem };
---

<CatalogDetailPage item={item} />
