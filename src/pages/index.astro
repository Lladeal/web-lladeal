---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Hero from '@sections/HeroSection.astro';
import Carrusel from '@sections/carrusel.astro';
import FeatureAnimated from '@sections/FeatureAnimated.astro';
import FeatureBento from '@sections/FeatureBento.astro';
import FeatureGrid from '@sections/FeatureGrid.astro';
import CTA from '@sections/CTA.astro';
import { withBase } from '@utils/links';

const localeRedirectMap = {
  en: withBase('/en'),
  ru: withBase('/ru'),
  zh: withBase('/zh'),
  de: withBase('/de'),
};
---

<BaseLayout>
  <script is:inline define:vars={{ localeRedirectMap }}>
    (() => {
      const isBot = /bot|crawler|spider|crawling|google|bing|yandex|baidu/i.test(
        navigator.userAgent,
      );

      if (isBot) return;

      const storedLocale = localStorage.getItem('preferredLocale');
      const browserLocale = (navigator.languages?.[0] || navigator.language || 'es').toLowerCase();
      const preferredLocale = storedLocale || browserLocale;

      const targetLocale = preferredLocale.startsWith('ru')
        ? 'ru'
        : preferredLocale.startsWith('zh')
          ? 'zh'
          : preferredLocale.startsWith('de')
            ? 'de'
          : preferredLocale.startsWith('en')
            ? 'en'
            : 'es';

      if (targetLocale === 'es') return;

      const targetHref = localeRedirectMap[targetLocale];
      if (!targetHref || window.location.pathname === targetHref) return;

      window.location.replace(targetHref);
    })();
  </script>
  <Hero />

  <Carrusel />

  <!-- <FeatureShowcase /> -->

  <FeatureBento />

  <FeatureAnimated />

  <FeatureGrid />

  <CTA />
</BaseLayout>
